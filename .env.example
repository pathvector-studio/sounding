# ==== Sounding 設定 ====
# cp .env.example .env の後、change-me-* をすべて置き換えること。
# シークレット生成: openssl rand -hex 32
# このファイルにはダミー値だけを書く。実際のキーは .env（git 管理外）にだけ書く。

# --- 共通 ---
# 同じマシンで 2 つ目のインスタンスを動かすときにコンテナ名の接頭辞を変える
SOUNDING_INSTANCE=sounding
# Web UI を開くポート
SOUNDING_PORT=8080
# Web UI を公開するアドレス。127.0.0.1 = このマシンだけ。0.0.0.0 = LAN から開ける（WEB_PASSWORD_HASH が必須。空だと web は起動しない）
BIND_ADDRESS=127.0.0.1
# ダイジェストの日付・スケジュールの基準
TZ=Asia/Tokyo
# コンテナ内のアプリユーザー（ホストのボリューム所有者に合わせる）
APP_UID=1000
APP_GID=1000

# --- PostgreSQL ---
# DATABASE_URL は docker-compose.yml が下の 3 つから組み立てる（ここには書かない）。
POSTGRES_USER=sounding
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=sounding

# --- Web UI ---
# ブラウザで開く URL（末尾スラッシュなし）。Atom フィードと配信メール内のリンクに使う。
PUBLIC_BASE_URL=http://localhost:8080
# セッション署名と Atom フィードのトークン用。32 バイト以上必須（短い・change-me のままだと web は起動しない）。
# 生成: `openssl rand -hex 32`。変えると全員がログアウトされ、Atom フィードの URL も変わる。
SESSION_SECRET=change-me-session-secret
# web が DB に繋ぐ読み取り専用ロール（sounding_web）のパスワード。生成: `openssl rand -hex 32`。
# worker が起動のたびにこの値をロールのパスワードに設定する。web にはこれだけを渡し、POSTGRES_PASSWORD は渡さない。
WEB_DB_PASSWORD=change-me-web-db-password
# Web UI のログインパスワードのハッシュ（scrypt）。生成: `docker compose exec sounding-worker python -m sounding hash-password`
# 出力の `scrypt$...` を単一引用符で囲んで書く（`$` が compose に解釈されないように。`$$` に置き換えても可）:
#   WEB_PASSWORD_HASH='scrypt$32768$8$1$<salt>$<hash>'
# 空ならログインなし（起動時に警告、全ページに帯を出す。Tailscale / Cloudflare Access の内側だけで使う場合）。
WEB_PASSWORD_HASH=

# --- LLM（BYO キー）---
# 既定は none（要約しない。キーを入れるまで何も外に送らない）。anthropic / openai にすると、worker が毎日 06:00（TZ）に
# IETF の会話の「議論の現在地」を要約する。件名・前処理した本文（アドレスは伏せる）・表示名が選んだプロバイダへ送られる。
# none | anthropic | openai
LLM_PROVIDER=none
# anthropic / openai で必須。1Password を使うなら op://Vault/Item/credential のように書ける形にする予定。
LLM_API_KEY=change-me-llm-api-key
# 用途の段ごとのモデル。cheap: 長い会話の分割要約など / main: 「議論の現在地」の生成
# anthropic: 空か change-me のままなら既定を使う（main: claude-opus-5-5、cheap: claude-haiku-5-5）。
# openai: 既定はない。両方を明示する（空か change-me のままだと要約ジョブは config_error で止まる）。
LLM_MODEL_CHEAP=change-me-cheap-model
LLM_MODEL_MAIN=change-me-main-model
# openai の接続先（OpenAI 互換サーバー用）。空ならプロバイダの既定。anthropic では使わない。
LLM_API_BASE=
# 1 日（TZ の暦日）の LLM 推定費用の上限（USD）。達したらその日の残りの要約を止める。0 なら無制限。
LLM_DAILY_BUDGET_USD=1.00
# 1 回の呼び出しの出力トークン上限。claude-opus-5-5 は常に思考し、思考のトークンもここに含まれるので小さくしすぎない。
LLM_MAX_OUTPUT_TOKENS=16000

# --- 取得 ---
# 興味プロファイル（コンテナ内のパス。compose が ./config を /app/config に読み取り専用で置く）。
# 既定のままでよい。config/profile.example.yaml を config/profile.yaml にコピーして編集する。
PROFILE_PATH=config/profile.yaml
# 取得間隔（分）
FETCH_INTERVAL_MINUTES=60
# 取得時の連絡先。HTTP の User-Agent に付け、IETF の匿名 IMAP ではパスワードとして送る（IETF の案内どおり）。
# ダイジェストの宛先ではない（宛先は DIGEST_TO）。
FETCH_CONTACT=change-me@example.com
# 空か change-me のままだと IETF ML の取得は行われない（RSS は動く）。
# 外部 HTTP / IMAP のタイムアウト（秒）
EXTERNAL_TIMEOUT_SECONDS=30
# 取得した本文をローカル DB に残す日数。過ぎたら本文を消し、要約とメタデータだけ残す。
CONTENT_RETENTION_DAYS=90
# 送信者の識別子（メールアドレスの HMAC）を作る秘密。DB にはメールアドレスそのものを入れない。
# 生成: `openssl rand -hex 32`。最初の起動のあとは変えないこと（変えると author_key がすべて変わる）。
# 空か change-me のままだと IETF ML の取得は行われない（RSS は動く）。
IDENTITY_SECRET=change-me-identity-secret

# --- IETF ---
# ML の取得手段（段 0 で決定。docs/DESIGN.md §1.3、docs/spike-phase0.md）: imap | rsync
IETF_MAIL_FETCH=imap
# 匿名 IMAP（TLS、993）。リストは "Shared Folders/<list>" のメールボックス
IETF_IMAP_HOST=imap.ietf.org
# 予備の取得手段（月次 mbox）
IETF_RSYNC_BASE=rsync.ietf.org::mailman-archive
IETF_DATATRACKER_BASE=https://datatracker.ietf.org
# 初回の取得で遡る日数（リストごと）
IETF_BACKFILL_DAYS=30
# 1 回の取得でリストごとに取り込む最大メッセージ数（超えた分は次回）
IETF_MAX_MESSAGES_PER_RUN=500
# 祖先の補完：期間外の議論の起点まで親をたどる上限（1 回の実行あたりの通数、さかのぼる日数）
IETF_ANCESTOR_MAX_DEPTH=50
IETF_ANCESTOR_MAX_AGE_DAYS=365

# --- 配信 ---
# 有効にするチャネル（カンマ区切り）: web,email,webhook,atom
#   web / atom は送らない（DB に入っていて Web UI と Atom フィードで読める）。email / webhook は worker がダイジェストを作った直後に送る。
#   email / webhook を有効にして、下の値を空か change-me のままにすると、そのチャネルだけ「not_configured」で失敗として記録される
#   （ダイジェストの作成は止まらない）。送るのは要約と出典リンクだけで、メッセージや記事の本文は送らない。
DELIVERY_CHANNELS=web,atom
# webhook（Discord / Slack 互換）。Discord のホスト（discord.com）なら `content`、Slack のホスト（hooks.slack.com）なら `text`、
# それ以外は両方を含む JSON を POST する。URL 自体が資格情報なので、ログにも DB にも出さない。リダイレクトは辿らない。
WEBHOOK_URL=https://example.com/change-me-webhook
# email（SMTP）。ポート 465 は最初から TLS、それ以外（587 など）は STARTTLS 必須（無暗号の送信にはフォールバックしない。
# サーバー証明書は検証する）。SMTP_USER が空ならログインしない。DIGEST_TO はカンマ区切りで複数可。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=sounding@example.com
DIGEST_TO=you@example.com
