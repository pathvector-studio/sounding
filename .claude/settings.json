{
  "permissions": {
    "ask": [
      "Bash(gh release*)",
      "Bash(gh workflow run*)",
      "Bash(git tag *)",
      "Bash(git clean*)",
      "Bash(git reset --hard*)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(*wrangler*)",
      "Bash(op *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(uv add *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(~/.config/sounding/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
